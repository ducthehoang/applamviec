# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG (ĐIỀN TRÊN VERCEL DASHBOARD HOẶC .env.local)
# ============================================================================

# 1. SUPABASE (Auth + PostgreSQL + Thumbnail Storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Dùng chuỗi kết nối Transaction Pooler cổng 6543 của Supabase cho Vercel Serverless:
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. GOOGLE DRIVE API (15GB lưu trữ file ảnh gốc & video nặng miễn phí)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# 3. FACEBOOK DEVELOPER GRAPH API (Liên kết 1 Fanpage cho cả 2 tài khoản cùng đăng)
NEXT_PUBLIC_FACEBOOK_APP_ID=123456789012345
FACEBOOK_APP_ID=123456789012345
FACEBOOK_APP_SECRET=abcdef1234567890

# 4. TIKTOK CONTENT POSTING API V2 (Đăng thẳng & Đẩy vào nháp TikTok)
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=aw1234567890
TIKTOK_CLIENT_KEY=aw1234567890
TIKTOK_CLIENT_SECRET=tiktok_secret_xxx

# 5. KHÓA BẢO MẬT CHO CRON TỰ ĐỘNG ĐĂNG BÀI (Tự đặt 1 chuỗi ngẫu nhiên dài >= 32 ký tự)
CRON_SECRET=change_me_to_a_long_random_secret_string_2026
